# Copy this file to .env and replace the local development values before starting services.
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Runtime application connection: this role has no BYPASSRLS and is not a table owner.
DATABASE_URL=postgresql://nexus_app:nexus_app_dev_only@localhost:5432/nexus_erp?schema=public
# Prisma migration connection: owns the application schema, with FORCE ROW LEVEL SECURITY enabled.
MIGRATION_DATABASE_URL=postgresql://nexus_migrator:nexus_migrator_dev_only@localhost:5432/nexus_erp?schema=public

POSTGRES_DB=nexus_erp
POSTGRES_USER=nexus_bootstrap
POSTGRES_PASSWORD=bootstrap_dev_only
POSTGRES_APP_PASSWORD=nexus_app_dev_only
POSTGRES_MIGRATOR_PASSWORD=nexus_migrator_dev_only
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Required only when running the seed command. Use a unique local password.
DEMO_USER_EMAIL=owner@nexus.local
DEMO_USER_PASSWORD=

# Local session cookie defaults. Set COOKIE_SECURE=true behind HTTPS in production.
SESSION_COOKIE_NAME=nexus.sid
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
