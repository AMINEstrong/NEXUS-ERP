# Copy this file to .env and replace the local development values before starting services.
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Runtime application connection: this role has no BYPASSRLS and is not a table owner.
DATABASE_URL=postgresql://nexus_app:nexus_app_dev_only@localhost:5432/nexus_erp?schema=public
# Prisma migration connection: owns the application schema, with FORCE ROW LEVEL SECURITY enabled.
MIGRATION_DATABASE_URL=postgresql://nexus_migrator:nexus_migrator_dev_only@localhost:5432/nexus_erp?schema=public

POSTGRES_DB=nexus_erp
POSTGRES_USER=nexus_bootstrap
POSTGRES_PASSWORD=bootstrap_dev_only
POSTGRES_APP_PASSWORD=nexus_app_dev_only
POSTGRES_MIGRATOR_PASSWORD=nexus_migrator_dev_only
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Required only when running the seed command. Use a unique local password.
DEMO_USER_EMAIL=owner@nexus.local
DEMO_USER_PASSWORD=

# Local session cookie defaults. Set COOKIE_SECURE=true behind HTTPS in production.
SESSION_COOKIE_NAME=nexus.sid
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Transactional e-mail (account verification and password reset)
# ---------------------------------------------------------------------------
# EMAIL_PROVIDER accepts: log | smtp | resend | sendgrid
#   log      Development only: renders the message and records delivery
#            metadata, but never sends or prints the body or links.
#   smtp     Any SMTP relay (nodemailer). Requires SMTP_HOST plus SMTP_USER
#            and SMTP_PASSWORD for a production relay.
#   resend   Resend HTTP API. Requires EMAIL_API_KEY.
#   sendgrid SendGrid HTTP API. Requires EMAIL_API_KEY.
# Production (NODE_ENV=production) refuses to start with EMAIL_PROVIDER=log.
EMAIL_PROVIDER=log

# Sender identity. In production the address must use a real, deliverable
# domain; the .local development default is rejected.
EMAIL_FROM=NEXUS ERP <no-reply@nexus.local>
# Optional Reply-To address. Leave empty to omit the header.
EMAIL_REPLY_TO=

# Hosted provider credentials (resend / sendgrid). Never exposed to the web app.
EMAIL_API_KEY=
# Optional API base URL override; defaults to the provider's public endpoint.
EMAIL_API_URL=
# Per-delivery timeout in milliseconds (1000-60000) and retry budget (1-5).
# Only transient failures (timeouts, connection errors, HTTP 429/5xx) retry.
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3

# SMTP relay settings (used when EMAIL_PROVIDER=smtp).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465), false for STARTTLS (usually 587).
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=

# Production (NODE_ENV=production) refuses to start unless:
#   - COOKIE_SECURE=true
#   - WEB_ORIGIN uses https://
#   - DATABASE_URL does not use a *_dev_only / changeme password
#   - EMAIL_PROVIDER is not "log"
#   - EMAIL_FROM uses a real domain (not .local)
#   - smtp: SMTP_HOST, SMTP_USER and SMTP_PASSWORD are set
#   - resend/sendgrid: EMAIL_API_KEY is set
# Set TRUST_PROXY to the reverse-proxy hop count or IP list when the API is
# behind a proxy (for example "1", "loopback" or "10.0.0.0/8").
TRUST_PROXY=false
